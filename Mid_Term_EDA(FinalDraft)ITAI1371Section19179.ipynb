      "cell_type": "code",
      "source": [
        "# =========================\n",
        "# 3. INITIAL CLEANING\n",
        "# =========================\n",
        "\n",
        "# Replace \"-\" with NaN\n",
        "df.replace(\"-\", np.nan, inplace=True)\n",
        "\n",
        "# Drop unneeded identifier columns\n",
        "df.drop(columns=[\"uid\", \"id.orig_h\", \"id.resp_h\", \"id.resp_p\", \"history\"], errors=\"ignore\", inplace=True)\n"
      ],
      "metadata": {
