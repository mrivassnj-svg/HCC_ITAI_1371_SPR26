import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# Load data
df = pd.read_csv("CTU-IoT-Malware-Capture-8-1conn_Use_this_one-1 (1).csv"")

# Replace placeholder nulls
df = df.replace("-", np.nan)

# Drop unnecessary columns if present
df.drop(columns=["id.resp_p","history","uid","id.orig_h","id.resp_h"], errors="ignore", inplace=True)

# Columns to clean
cols_to_fix = ["duration","orig_bytes","orig_pkts"]

# Convert types BEFORE split so medians work
for col in cols_to_fix:
    df[col] = pd.to_numeric(df[col], errors="coerce")

# Split dataset (70/30 as required)
train_df, test_df = train_test_split(df, test_size=0.3, random_state=42)

# Get medians ONLY from training data
train_medians = train_df[cols_to_fix].median()

def preprocess(data, medians):
    d = data.copy()

    # Fill missing values using training medians
    for col in cols_to_fix:
        d[col] = d[col].fillna(medians[col])

    # Feature Engineering
    d["bytes_per_packet"] = d["orig_bytes"] / (d["orig_pkts"] + 1)
    d["packet_density"] = d["orig_pkts"] / (d["duration"] + 1)

    return d

# Apply preprocessing
train_df = preprocess(train_df, train_medians)
test_df = preprocess(test_df, train_medians)

# One-hot encoding
train_df = pd.get_dummies(train_df)
test_df = pd.get_dummies(test_df)

# Align columns
test_df = test_df.reindex(columns=train_df.columns, fill_value=0)

# Scaling (fit ONLY on training data)
scaler = StandardScaler()
train_df_scaled = scaler.fit_transform(train_df)
test_df_scaled = scaler.transform(test_df)
