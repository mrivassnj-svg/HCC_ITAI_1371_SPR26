# Corrected Logic with Sound Implmentation
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# 1. Load and Basic Clean
df = pd.read_csv('your_data.csv')
df = df.replace("-", np.nan) # Standardize nulls

# 2. Split First
train_df, test_df = train_test_split(df, test_size=0.3, random_state=42)

# 3. Preprocessing Function (To ensure both sets get same features)
def preprocess(data, medians=None):
    d = data.copy()
    # Convert types
    cols_to_fix = ["duration", "orig_bytes", "orig_pkts"]
    for col in cols_to_fix:
        d[col] = pd.to_numeric(d[col], errors="coerce")
        # Fill with medians from training set
        if medians is not None:
            d[col] = d[col].fillna(medians[col])
            
    # Feature Engineering
    d["bytes_per_packet"] = d["orig_bytes"] / (d["orig_pkts"] + 1)
    d["packet_density"] = d["orig_pkts"] / (d["duration"] + 1)
    
    return d

# Get medians from train only to avoid leakage
train_medians = train_df[["duration", "orig_bytes", "orig_pkts"]].median()

train_df = preprocess(train_df, train_medians)
test_df = preprocess(test_df, train_medians)

# 4. Encoding and Scaling (Handle carefully to match columns)
train_df = pd.get_dummies(train_df)
test_df = pd.get_dummies(test_df)
test_df = test_df.reindex(columns=train_df.columns, fill_value=0)
